# Portainer Stack > Environment variables

APP_ENV=production
PUBLIC_BASE_URL=https://drive.neciparmagan.net.tr

POSTGRES_DB=necipdrive
POSTGRES_USER=necipdrive
POSTGRES_PASSWORD=guclu-db-sifresi-degistir

SESSION_SECRET=en-az-16-karakter-rastgele-oturum-anahtari
SHARE_PASSWORD_SALT=en-az-16-karakter-baska-rastgele-deger

MAX_UPLOAD_BYTES=10737418240
MAX_UPLOAD_BATCH_BYTES=10737418240
UPLOAD_CHUNK_BYTES=8388608
FREE_QUOTA_BYTES=5368709120
SESSION_TTL=24h
SHARE_TOKEN_BYTES=24


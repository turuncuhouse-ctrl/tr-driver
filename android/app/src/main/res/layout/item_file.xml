<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@android:color/white"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <CheckBox
        android:id="@+id/itemCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/itemThumb"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="#E8F2FC"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/itemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/tr_ink"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/itemMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/tr_ink" />

        <TextView
            android:id="@+id/itemBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#0B5CAD"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <Button
        android:id="@+id/itemStar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:text="☆" />

    <Button
        android:id="@+id/itemShare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:text="↗" />

    <Button
        android:id="@+id/itemDownload"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="İndir" />

    <Button
        android:id="@+id/itemDelete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sil" />
</LinearLayout>

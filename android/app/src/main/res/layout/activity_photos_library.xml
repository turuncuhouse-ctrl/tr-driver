<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tr_sky"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/photosTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/gallery_launcher_name"
                android:textColor="@color/tr_ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/photosSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tüm fotoğraf ve videolar"
                android:textColor="@color/tr_ink"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnPhotosSelect"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="Seç"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnPhotosMore"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="⋯"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnPhotosClose"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="Kapat"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Search alone — never under backup/sticky -->
    <EditText
        android:id="@+id/photosSearch"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="6dp"
        android:background="@android:color/white"
        android:hint="Ara…"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="14dp"
        android:textColor="@color/tr_ink"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/galleryBackupChip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="4dp"
        android:background="@android:color/white"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:text="Yedek: Wi‑Fi"
        android:textColor="@color/tr_ink"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/legacyTabs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button android:id="@+id/tabPhotos" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Fotoğraflar" />
        <Button android:id="@+id/tabAlbums" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Albümler" />
        <Button android:id="@+id/tabCloud" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Bulut" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/filterScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/filterAll"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:text="Tümü"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/filterPhotos"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:text="Fotoğraf"
                android:textSize="12sp" />

            <Button
                android:id="@+id/filterVideos"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:text="Video"
                android:textSize="12sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:layout_marginHorizontal="4dp"
                android:background="#33000000" />

            <Button
                android:id="@+id/zoomDay"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:text="Gün"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/zoomMonth"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:text="Ay"
                android:textSize="12sp" />

            <Button
                android:id="@+id/zoomYear"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:text="Yıl"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Date bar sits between chrome and grid — never overlaps search -->
    <TextView
        android:id="@+id/stickyTimelineHeader"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="#E8F0F8"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:text="Tarih"
        android:textColor="@color/tr_ink"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/photosGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="1dp" />

        <LinearLayout
            android:id="@+id/galleryEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/galleryEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Henüz fotoğraf yok"
                android:textColor="@color/tr_ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/galleryEmptyBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Galeri izni verin veya Wi‑Fi ile yedeklemeyi açın."
                android:textColor="@color/tr_ink"
                android:textSize="14sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/photosProgress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:elevation="8dp"
        android:minHeight="48dp">

        <LinearLayout
            android:id="@+id/galleryBottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="2dp">

            <Button
                android:id="@+id/navPhotos"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Fotoğraflar"
                android:textColor="@color/tr_blue"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/navAlbums"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Albümler"
                android:textColor="@color/tr_ink"
                android:textSize="12sp" />

            <Button
                android:id="@+id/navLibrary"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Kitaplık"
                android:textColor="@color/tr_ink"
                android:textSize="12sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/selectionBarScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E8F2FC"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/selectionBar"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <TextView
                    android:id="@+id/selectionCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="72dp"
                    android:paddingHorizontal="8dp"
                    android:text="0 seçili"
                    android:textColor="@color/tr_ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button style="?android:attr/borderlessButtonStyle" android:id="@+id/btnSelectAll" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="0dp" android:text="Tümü" android:textSize="13sp" />
                <Button style="?android:attr/borderlessButtonStyle" android:id="@+id/btnShareSelected" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="0dp" android:text="Paylaş" android:textSize="13sp" />
                <Button style="?android:attr/borderlessButtonStyle" android:id="@+id/btnUploadSelected" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="0dp" android:text="Buluta" android:textSize="13sp" />
                <Button style="?android:attr/borderlessButtonStyle" android:id="@+id/btnOpenSelected" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="0dp" android:text="Aç" android:textSize="13sp" />
                <Button style="?android:attr/borderlessButtonStyle" android:id="@+id/btnInfoSelected" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="0dp" android:text="Bilgi" android:textSize="13sp" />
                <Button style="?android:attr/borderlessButtonStyle" android:id="@+id/btnDeleteSelected" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="0dp" android:text="Sil" android:textSize="13sp" />
                <Button style="?android:attr/borderlessButtonStyle" android:id="@+id/btnCancelSelect" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="0dp" android:text="İptal" android:textSize="13sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </FrameLayout>
</LinearLayout>

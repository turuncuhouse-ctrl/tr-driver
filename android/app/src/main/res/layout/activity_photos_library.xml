<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tr_sky"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/photosTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/gallery_launcher_name"
            android:textColor="@color/tr_ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPhotosSelect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seç" />

        <Button
            android:id="@+id/btnPhotosMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⋯" />

        <Button
            android:id="@+id/btnPhotosClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kapat" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <Button
            android:id="@+id/tabPhotos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Fotoğraflar"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tabAlbums"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Albümler" />

        <Button
            android:id="@+id/tabCloud"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bulut" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/filterAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tümü"
                android:textStyle="bold" />

            <Button
                android:id="@+id/filterPhotos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fotoğraf" />

            <Button
                android:id="@+id/filterVideos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Video" />
        </LinearLayout>
    </HorizontalScrollView>

    <EditText
        android:id="@+id/photosSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="4dp"
        android:hint="Ara (dosya, albüm…)"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:textColor="@color/tr_ink"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/photosSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="Tüm fotoğraf ve videolar"
        android:textColor="@color/tr_ink"
        android:textSize="12sp" />

    <HorizontalScrollView
        android:id="@+id/selectionBarScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/selectionBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#E8F2FC"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">

            <TextView
                android:id="@+id/selectionCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="72dp"
                android:paddingStart="6dp"
                android:paddingEnd="8dp"
                android:text="0 seçili"
                android:textColor="@color/tr_ink"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSelectAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tümü" />

            <Button
                android:id="@+id/btnShareSelected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paylaş" />

            <Button
                android:id="@+id/btnUploadSelected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buluta" />

            <Button
                android:id="@+id/btnOpenSelected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aç" />

            <Button
                android:id="@+id/btnInfoSelected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bilgi" />

            <Button
                android:id="@+id/btnDeleteSelected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sil" />

            <Button
                android:id="@+id/btnCancelSelect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="İptal" />
        </LinearLayout>
    </HorizontalScrollView>

    <ProgressBar
        android:id="@+id/photosProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/photosGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="4dp" />
</LinearLayout>

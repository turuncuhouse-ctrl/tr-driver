<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/callsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tr_sky"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tr_blue"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp">

        <Button
            android:id="@+id/btnBackCalls"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="@color/tr_blue_dark"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="← Geri"
            android:textAllCaps="false"
            android:textColor="@color/tr_white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LocalTel Aramalar"
                android:textColor="@color/tr_white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLocalTelHeaderStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Durum: kontrol ediliyor..."
                android:textColor="#DBEAFE"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnReturnActiveCall"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="#16A34A"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:text="Aktif Arama"
            android:textAllCaps="false"
            android:textColor="@color/tr_white"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:orientation="horizontal"
        android:padding="6dp">

        <Button
            android:id="@+id/tabDialerContacts"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:backgroundTint="@color/tr_blue"
            android:text="Ara &amp; Rehber"
            android:textAllCaps="false"
            android:textColor="@color/tr_white"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/tr_sky"
            android:text="LocalTel Ayarları"
            android:textAllCaps="false"
            android:textColor="@color/tr_ink"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Permissions summary card -->
            <LinearLayout
                android:id="@+id/cardPermissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="#FFFBEB"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Arama izinleri"
                    android:textColor="#92400E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPermissionsSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#78350F"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnFixMicPerm"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/tr_blue"
                        android:minWidth="0dp"
                        android:text="Mikrofon"
                        android:textAllCaps="false"
                        android:textColor="@color/tr_white"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnFixContactsPerm"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/tr_blue"
                        android:minWidth="0dp"
                        android:text="Rehber"
                        android:textAllCaps="false"
                        android:textColor="@color/tr_white"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnFixFsiPerm"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/tr_blue"
                        android:minWidth="0dp"
                        android:text="Kilit Ekranı"
                        android:textAllCaps="false"
                        android:textColor="@color/tr_white"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tab 1: Dialer & Contacts -->
            <LinearLayout
                android:id="@+id/panelDialerContacts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@android:color/white"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Numara veya Dahili Ara"
                        android:textColor="@color/tr_ink"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etDialTarget"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Örn: 0555 111 22 33, 101 veya sip:ali@..."
                        android:imeOptions="actionSend"
                        android:inputType="text"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/tvDialMatchPreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/tr_blue"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnCallNow"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:backgroundTint="#16A34A"
                            android:text="Ara (LocalTel)"
                            android:textAllCaps="false"
                            android:textColor="@color/tr_white"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnTestIncomingRing"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:backgroundTint="@color/tr_sky"
                            android:text="Gelen Test (4 sn)"
                            android:textAllCaps="false"
                            android:textColor="@color/tr_ink" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/white"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Rehber Kişileri"
                            android:textColor="@color/tr_ink"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnRefreshContacts"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:backgroundTint="@color/tr_sky"
                            android:minWidth="0dp"
                            android:paddingHorizontal="10dp"
                            android:text="Yenile"
                            android:textAllCaps="false"
                            android:textColor="@color/tr_blue"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etContactSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="İsim veya numara ile ara..."
                        android:inputType="text"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/tvContactsEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="Rehber erişimi yok veya eşleşen kişi bulunamadı."
                        android:textColor="#52606D"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvCallContacts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tab 2: LocalTel Provider Settings -->
            <LinearLayout
                android:id="@+id/panelLocalTelSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/white"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LocalTel Sağlayıcı Yapılandırması"
                    android:textColor="@color/tr_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Parolalar cihazda Keystore ile şifreli saklanır ve günlük kayıtlarına (log) yazılmaz."
                    android:textColor="#52606D"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swLocalTelEnabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="LocalTel aramaları etkin"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Sağlayıcı türü"
                    android:textColor="@color/tr_ink"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgProviderType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbProviderSip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="SIP (RFC 3261)" />

                    <RadioButton
                        android:id="@+id/rbProviderGateway"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ağ Geçidi (WSS)" />
                </RadioGroup>

                <EditText
                    android:id="@+id/etServerUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Sunucu URL / Host (örn: sip.localtel.example)"
                    android:inputType="textUri"
                    android:maxLines="1" />

                <EditText
                    android:id="@+id/etSipDomain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="SIP Alan Adı / Realm (boşsa sunucu adresi)"
                    android:inputType="textUri"
                    android:maxLines="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etSipPort"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Port (5060)"
                        android:inputType="number"
                        android:maxLines="1" />

                    <Spinner
                        android:id="@+id/spTransport"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etSipUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Kullanıcı Adı / SIP Hesabı"
                    android:inputType="textNoSuggestions"
                    android:maxLines="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etExtension"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Dahili (örn: 1001)"
                        android:inputType="text"
                        android:maxLines="1" />

                    <EditText
                        android:id="@+id/etDisplayName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:hint="Görünen Ad"
                        android:inputType="textPersonName"
                        android:maxLines="1" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etSipSecret"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="SIP Parolası / Token"
                    android:inputType="textPassword"
                    android:maxLines="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etOutboundPrefix"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Dış hat ön eki"
                        android:inputType="phone"
                        android:maxLines="1" />

                    <EditText
                        android:id="@+id/etCountryCode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:hint="Ülke kodu (90)"
                        android:inputType="number"
                        android:maxLines="1" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swAutoRegister"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Arka planda gelen aramalar için otomatik bağlan" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swSyncToServer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="TR Driver sunucusuyla şifreli senkronize et" />

                <Button
                    android:id="@+id/btnSaveLocalTel"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="@color/tr_blue"
                    android:text="Kaydet ve Bağlan"
                    android:textAllCaps="false"
                    android:textColor="@color/tr_white"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnFetchServerConfig"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/tr_sky"
                        android:text="Sunucudan Yükle"
                        android:textAllCaps="false"
                        android:textColor="@color/tr_ink" />

                    <Button
                        android:id="@+id/btnClearLocalTel"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="#FEE2E2"
                        android:text="Ayarları Temizle"
                        android:textAllCaps="false"
                        android:textColor="#991B1B" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

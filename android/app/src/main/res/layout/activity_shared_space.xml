<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tr_sky"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/shared_space_title"
        android:textColor="@color/tr_ink"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sharedPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="start"
        android:singleLine="true"
        android:textColor="@color/tr_ink"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/sharedQuota"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/tr_ink"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSharedUp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/shared_space_up" />

        <Button
            android:id="@+id/btnSharedUpload"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/shared_space_upload" />

        <Button
            android:id="@+id/btnSharedNewFolder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/shared_space_new_folder" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/sharedProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:indeterminate="true"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/sharedStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textColor="@color/tr_ink"
        android:textSize="13sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/sharedList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/white" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tr_sky"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Yedekleme ayarları"
            android:textColor="@color/tr_ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Galeri ve seçtiğiniz klasörler yalnızca Wi‑Fi üzerinden yedeklenir. Mobil veri kullanılmaz."
            android:textColor="@color/tr_ink" />

        <Button
            android:id="@+id/btnOpenPermissionWizard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Ayarlar · Tüm izinler"
            android:textAllCaps="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:orientation="vertical"
            android:padding="12dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchGalleryBackup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Otomatik yedekle (foto, video, ses, dosya)"
                android:textColor="@color/tr_ink" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Yedeklenecek türler"
                android:textColor="@color/tr_ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchPhotoBackup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fotoğraflar"
                android:textColor="@color/tr_ink" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchVideoBackup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Videolar"
                android:textColor="@color/tr_ink" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchAudioBackup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ses dosyaları (müzik, kayıt)"
                android:textColor="@color/tr_ink" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchDocBackup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Belgeler ve dosyalar (pdf, doc, xls, zip, apk…)"
                android:textColor="@color/tr_ink" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Rehber ve SMS yedeği"
                android:textColor="@color/tr_ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/commsHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kişiler ve SMS’ler yalnızca Wi‑Fi bağlıyken, şifreli olarak kendi sunucunuza yedeklenir. İzinler açıklama diyaloğuyla istenir; istediğiniz an kapatabilirsiniz. Artımlı çalışır: değişmeyen kayıtlar tekrar yüklenmez."
                android:textColor="@color/tr_ink"
                android:textSize="12sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchContactsBackup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rehber (kişiler)"
                android:textColor="@color/tr_ink" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchSmsBackup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SMS mesajları"
                android:textColor="@color/tr_ink" />

            <TextView
                android:id="@+id/commsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tr_ink"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnPurgeComms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sunucudaki rehber/SMS yedeğini sil" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchAllFilesAccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tüm dosyalara erişim (klasör seçimi olmadan tam yedek)"
                android:textColor="@color/tr_ink" />

            <TextView
                android:id="@+id/networkHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Yedekleme: yalnız Wi‑Fi, sınırlı hız (~0.5 MB/s). WhatsApp ve diğer uygulamalar çalışmaya devam eder; Wi‑Fi gelince arka planda kaldığı yerden devam eder."
                android:textColor="@color/tr_ink"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnOemSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Arka plan izinleri (Xiaomi / pil)" />

            <Button
                android:id="@+id/btnBackupNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Şimdi yedekle (Wi‑Fi)" />

            <Button
                android:id="@+id/btnOpenPhotos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TR Photos (bulut galeri)" />

            <Button
                android:id="@+id/btnFreeUpSpace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Yer aç (yedeklenenleri telefonda sil)"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/backupStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/tr_ink"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Ek yedeklenecek klasörler"
            android:textColor="@color/tr_ink"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="SAF ile klasör seçin. Hedef: TR Backup / cihaz / klasör adı"
            android:textColor="@color/tr_ink"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnAddFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Klasör ekle (SAF)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Hızlı klasörler"
            android:textColor="@color/tr_ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Download, DCIM, Pictures, Documents, Music, Movies, WhatsApp medya ve WhatsApp yedek klasörü. Tüm dosyalara erişim açıkken tek dokunuşla eklenir; değilse sistem seçici açılır."
            android:textColor="@color/tr_ink"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/presetList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp" />

        <LinearLayout
            android:id="@+id/folderList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp" />

        <Button
            android:id="@+id/btnCloseBackup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Kapat" />
    </LinearLayout>
</ScrollView>

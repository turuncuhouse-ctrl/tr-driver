<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tr_sky"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Yedekleme ayarları"
            android:textColor="@color/tr_ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Galeri ve seçtiğiniz klasörler TR Driver sunucusuna yüklenir."
            android:textColor="@color/tr_ink" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:orientation="vertical"
            android:padding="12dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchGalleryBackup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Otomatik foto/video yedekle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ağ tercihi (en az biri açık olmalı)"
                android:textColor="@color/tr_ink"
                android:textStyle="bold" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchBackupWifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Wi‑Fi'de yedekle" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchBackupMobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mobil veride yedekle" />

            <TextView
                android:id="@+id/networkHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mobil veri çoğu kullanıcı için önerilir. Wi‑Fi'de yedekleme pil ve kota dostudur."
                android:textColor="@color/tr_ink"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnOemSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Arka plan izinleri (Xiaomi / pil)" />

            <Button
                android:id="@+id/btnBackupNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Şimdi yedekle" />

            <Button
                android:id="@+id/btnOpenPhotos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TR Photos (bulut galeri)" />

            <Button
                android:id="@+id/btnFreeUpSpace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Yer aç (yedeklenenleri telefonda sil)"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/backupStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/tr_ink"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Ek yedeklenecek klasörler"
            android:textColor="@color/tr_ink"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="SAF ile klasör seçin. Hedef: TR Backup / cihaz / klasör adı"
            android:textColor="@color/tr_ink"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnAddFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Klasör ekle" />

        <LinearLayout
            android:id="@+id/folderList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp" />

        <Button
            android:id="@+id/btnCloseBackup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Kapat" />
    </LinearLayout>
</ScrollView>

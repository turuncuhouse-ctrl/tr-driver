APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://necipdrive:CHANGE_ME@localhost:5432/necipdrive?sslmode=disable
SESSION_SECRET=change-this-to-a-long-random-secret
SHARE_PASSWORD_SALT=change-this-share-salt-16+
# Rehber + SMS yedeğinin sunucuda şifrelenmesi (AES-256-GCM). Boşsa SESSION_SECRET
# kullanılır; ayrı bir değer verirseniz SESSION_SECRET döndürülse bile eski
# kayıtlar okunabilir kalır. En az 16 karakter.
PERSONAL_BACKUP_KEY=
# LocalTel IP/SIP ayarlarının sunucuda şifrelenmesi (AES-256-GCM). Boşsa
# PERSONAL_BACKUP_KEY / SESSION_SECRET kullanılır. En az 16 karakter.
LOCAL_TEL_KEY=
# LocalTel 0.13.0: çağrı geçidi aynı TR Driver alan adında /localtel/ws olarak sunulur.
# LOCAL_TEL_DOMAIN boşsa isteğin güvenilir Host başlığı kullanılır.
LOCAL_TEL_DOMAIN=
LOCAL_TEL_TOKEN_TTL=15m
LOCAL_TEL_AUTO_PROVISION=true
DATA_DIR=./data
PUBLIC_BASE_URL=http://localhost:8080
ALLOW_REGISTRATION=true
UPDATE_MANIFEST_URL=
UPDATE_CHANNEL=stable
# keys/public.key içeriği (base64 Ed25519)
LICENSE_PUBLIC_KEY=PDtEkEVeAOcC76XWw8sjZbZDHlkS0Gl0S6x/s7whWe0=
# LICENSE_PRIVATE_KEY=
# LICENSE_ALLOW_DEV_SIGNING=1
# LICENSE_VENDOR_MODE=false
# 0 / auto / boş = DATA_DIR disk kapasitesi (önerilen)
FREE_QUOTA_BYTES=0
MAX_UPLOAD_BYTES=10737418240
POSTGRES_PASSWORD=CHANGE_ME

# Cihaz token ömrü: 0 = süresiz (yalnızca iptal/şifre sıfırlama ile biter). Pozitif süre verilirse örn. 720h.
DEVICE_TOKEN_TTL=0
# Sync değişim geçmişi saklama süresi (varsayılan 90 gün)
FILE_CHANGE_RETENTION=2160h
# Yalnızca güvendiğiniz ters vekil ağları (virgülle CIDR). Boşsa X-Forwarded-* yok sayılır.
# Örnek: 172.18.0.0/16,10.0.0.0/8
TRUSTED_PROXY_CIDRS=

# --- Ortak Paylaşım + torrent (docs/SHARED_SPACE.md) ---
# Yöneticinin izin verdiği kullanıcılarla paylaşılan sunucu klasörü. Boşsa DATA_DIR'in
# yanındaki "paylasim" klasörü kullanılır. DATA_DIR ile aynı ya da iç içe olamaz.
# Sunucu yedeğine (BACKUP_*) dahil DEĞİLDİR.
SHARED_DIR=./paylasim
# Alanın toplam boyut sınırı (bayt). 0 = sınır yok, disk dolana kadar.
SHARED_QUOTA_BYTES=0
# Doluluk uyarı eşiği (1-99).
SHARED_QUOTA_WARN_PERCENT=90
# Herkese açık bağlantıların en uzun geçerlilik süresi.
SHARED_LINK_MAX_TTL=720h
# Torrent indirme (yalnızca yönetici). false = istemci hiç başlamaz.
TORRENT_ENABLED=true
# Eş bağlantı portu (TCP + UDP). Docker'da iç ve dış port aynı olmalıdır.
TORRENT_LISTEN_PORT=42069
# Hız sınırları, KB/sn. 0 = sınırsız. Yönetim panelinden de değiştirilebilir.
TORRENT_DOWNLOAD_LIMIT_KBPS=0
TORRENT_UPLOAD_LIMIT_KBPS=0
# true = tamamlanan torrent paylaşılmaya (seed) devam eder.
TORRENT_SEED_AFTER_COMPLETE=false
# true = DHT kapalı, yalnızca tracker.
TORRENT_DISABLE_DHT=false

# --- Sunucu yedekleri (docs/BACKUP.md) ---
# BACKUP_PASSWORD boşsa zamanlayıcı kapalı kalır (sunucu normal açılır).
BACKUP_ENABLED=true
BACKUP_DIR=./backups/restic
BACKUP_PASSWORD=
BACKUP_SCHEDULE=02:00
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
BACKUP_MAX_AGE=30h
BACKUP_TIMEOUT=6h
BACKUP_RUN_ON_BOOT=false
BACKUP_VERIFY_RESTORE=false
BACKUP_WEBHOOK_URL=
# Offsite S3 (opsiyonel; bucket+anahtarlar doluysa etkinleşir):
#BACKUP_S3_ENDPOINT=https://s3.eu-central-1.wasabisys.com
#BACKUP_S3_REGION=eu-central-1
#BACKUP_S3_BUCKET=
#BACKUP_S3_PREFIX=trdriver
#BACKUP_S3_ACCESS_KEY=
#BACKUP_S3_SECRET_KEY=
